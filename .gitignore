# =====================================================================
# Reproducibility policy: only sources, scripts, constraints, plans,
# memory, docs, and the golden hardware container (.xsa) are versioned.
# Heavy transient intermediate runs and caches are ignored.
# =====================================================================

# ---- Python virtual environment (recreate with `make -C app/hw venv`)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- Generic outputs of agent hooks and scratch data
/out/
build/
*.log
*.jou
*.str
*.bak
*.tmp
*~
.DS_Store
Thumbs.db
.vscode/
.clangd*

# ---- ESP-IDF ESP32 build artifacts (recreated via idf.py build)
esp32/build/
esp32/sdkconfig
esp32/sdkconfig.old

# ---- VUnit / GHDL simulation outputs
cora7z/app/hw/build/
cora7z/app/hw/vunit_out/
*vhdl_ls.toml
*.ghw
*.vcd
*.fst
*.o
*.cf

# ---- Vivado: intermediate compilation runs and caches are ignored
cora7z/app/hw/vivado/*
!cora7z/app/hw/vivado/.gitkeep
# Preserve the golden exported hardware platform container (359 KB)
# Allows immediate software build & flashing without requiring a 3-minute Vivado synthesis run
!cora7z/app/hw/vivado/cora7z_top.xsa

*.xpr
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.gen/
*.srcs/
.Xil/
xsim.dir/
*.wdb
*.dcp
*.bit
*.bin
*.BIN
*.sysdef
*.hdf
*.ltx
*.prm
*.pb
*.rpt
*.rpx
vivado_pid*.str
hs_err_pid*.log
nlviewcommon.logfile

# Ignore arbitrary intermediate XSA containers, but keep the authoritative platform
*.xsa
!cora7z/app/hw/vivado/cora7z_top.xsa

# ---- Vitis: the workspace is regenerated from app/sw/scripts/*
# Versioned: app/sw/src/ and app/sw/scripts/
cora7z/app/sw/vitis/*
!cora7z/app/sw/vitis/.gitkeep
*.elf
*.elf.size
*.map
*.pdi
*.lock
.vitis*

# ---- Raw benchmark dumps stay local; summarized CSVs are versioned
cora7z/app/test_results/raw/

# ---- Agent working state that must not be committed
.agents/snapshots/
.agent/
utils/plan/.bak/
utils/memory/handoff/done/

# ---- LaTeX intermediate build artifacts
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

